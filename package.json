{
  "name": "fewwords-website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ignore-pattern 'dev-docs/**'",
    "lint:fix": "eslint . --fix --ignore-pattern 'dev-docs/**'",
    "type": "nuxt typecheck",
    "check": "bun run lint && bun type",
    "shadcn": "bunx --bun shadcn-vue@latest add",
    "db:start:pg": "docker compose -f local-database/docker-compose.yml up -d",
    "db:stop:pg": "docker compose -f local-database/docker-compose.yml down",
    "db:reset": "docker compose -f local-database/docker-compose.yml down -v && docker compose -f local-database/docker-compose.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@nuxt/content": "3.11.0",
    "@nuxt/eslint": "1.13.0",
    "@nuxt/fonts": "0.13.0",
    "@nuxt/hints": "1.0.0-alpha.5",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxtjs/mdc": "^0.20.0",
    "@openrouter/sdk": "^0.8.0",
    "@unhead/vue": "^2.0.3",
    "@unovis/ts": "^1.6.2",
    "@unovis/vue": "^1.6.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.0.0",
    "lucide-vue-next": "^0.563.0",
    "marked": "^17.0.1",
    "nanoid": "^5.1.6",
    "nuxt": "^4.3.0",
    "nuxt-toastify": "1.1.0",
    "openai": "^6.18.0",
    "postgres": "^3.4.8",
    "reka-ui": "^2.7.0",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^4.0.0",
    "@radya/nuxt-dompurify": "^1.0.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.1.0",
    "dompurify": "^3.3.1",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  }
}
