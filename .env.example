# Environment
NODE_ENV=development

# Site URLs - Used for magic links, redirects, etc.
NUXT_SITE_URL=http://localhost:3001

# Nuxt Session - Required for authentication (min 32 characters)
NUXT_SESSION_PASSWORD=your-secure-session-password-min-32-chars

# PostgreSQL Database
# Local/Development: Use Docker on port 5433
DATABASE_URL=postgresql://fewwords:fewwords_dev_password@localhost:5433/fewwords

# Production: Use remote database
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Jina AI - Article content fetching
JINA_AI_API_KEY=your_jina_ai_api_key

# LLM Providers - Multi-provider support

# OpenRouter - Default provider (supports multiple models)
OPENROUTER_API_KEY=your_openrouter_api_key

# OpenAI - For consuming OpenAI credits
OPENAI_API_KEY=your_openai_api_key

# Anthropic - For consuming Anthropic credits
ANTHROPIC_API_KEY=your_anthropic_api_key

# YouTube Data API - Video metadata fetching
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key

# Redis - For real-time stage updates via SSE
# Local/Development: Use local Redis via Docker
REDIS_URL=redis://localhost:6380

# Production: Use Upstash cloud (separate instance = separate data)
# Get your Redis URL from Upstash dashboard
# Format: rediss://default:TOKEN@HOST:6379
# REDIS_URL=rediss://default:your_upstash_token@xxx.upstash.io:6379

# Resend - Email service for magic links
# Get free API key at resend.com
# Production: magiclink@m.fewwords.app
# Staging: testauth@staging.fewwords.app
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=magiclink@m.fewwords.app

# Email sender name
RESEND_FROM_NAME=Fewwords
